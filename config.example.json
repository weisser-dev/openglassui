{
  "workspace": ".",
  "agents": [
    {
      "id": "codex",
      "name": "Codex",
      "command": "codex",
      "args": [
        "exec",
        "--json",
        "-"
      ],
      "input": "stdin",
      "resumeArgs": [
        "exec",
        "resume",
        "--json",
        "{sessionId}",
        "-"
      ]
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "command": "claude",
      "args": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "input": "stdin",
      "resumeArgs": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--resume",
        "{sessionId}"
      ]
    },
    {
      "id": "kiro",
      "name": "Kiro CLI",
      "command": "kiro-cli",
      "args": [
        "chat",
        "--no-interactive",
        "--output-format",
        "stream-json"
      ],
      "input": "stdin"
    }
  ]
}
